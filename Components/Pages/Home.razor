@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject PiAssistant.Services.SystemPromptService SystemPrompt
@using PiAssistant.Models
@using Markdig
@inject PiAssistant.Services.OllamaService Ollama
@inject PiAssistant.Services.DatabaseService Database
@inject PiAssistant.Services.EmbeddingService Embeddings
@inject PiAssistant.Services.ToolExecutor ToolExecutor
<PageTitle>Pi Assistant</PageTitle>

<div class="chat-container">

    <div class="messages" @ref="chatContainer">

        @foreach (var message in Messages)
        {
            <div class="message-row @(message.Role == "User" ? "user-row" : "assistant-row")">

                <div class="message-bubble @(message.Role == "User" ? "user-bubble" : "assistant-bubble")">

                    <div class="message-role">
                        @message.Role
                    </div>

                    <div class="message-content markdown-body">
                        @((MarkupString)Markdown.ToHtml(message.Content))
                    </div>

                </div>

            </div>
        }

    </div>

    <div class="input-area">

        <textarea class="prompt-box" @bind="Prompt" @bind:event="oninput" placeholder="Send a message...">
        </textarea>

        <button class="send-button" @onclick="Ask">
            Send
        </button>

    </div>

</div>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 90vh;
        max-width: 1000px;
        margin: auto;
        padding: 20px;
    }

    .messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        border: 1px solid #333;
        border-radius: 10px;
        background: #111;
    }

    .message-row {
        display: flex;
        margin-bottom: 20px;
    }

    .user-row {
        justify-content: flex-end;
    }

    .assistant-row {
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 80%;
        padding: 15px;
        border-radius: 16px;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .user-bubble {
        background: #2563eb;
        color: white;
    }

    .assistant-bubble {
        background: #222;
        color: white;
    }

    .message-role {
        font-size: 0.8rem;
        opacity: 0.7;
        margin-bottom: 8px;
    }

    .message-content {
        line-height: 1.5;
    }

    .input-area {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .prompt-box {
        flex: 1;
        height: 80px;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid #444;
        background: #1a1a1a;
        color: white;
        resize: none;
        font-size: 1rem;
    }

    .send-button {
        width: 120px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        font-size: 1rem;
        cursor: pointer;
    }

    .send-button:hover {
        background: #1d4ed8;
    }

    .markdown-body h1,
    .markdown-body h2,
    .markdown-body h3 {
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .markdown-body p {
        margin-bottom: 12px;
    }

    .markdown-body code {
        background: #111;
        padding: 2px 6px;
        border-radius: 6px;
        font-family: monospace;
    }

    .markdown-body pre {
        background: #0d1117;
        padding: 15px;
        border-radius: 10px;
        overflow-x: auto;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .markdown-body pre code {
        background: transparent;
        padding: 0;
    }

    .markdown-body ul {
        margin-left: 20px;
    }

    .markdown-body li {
        margin-bottom: 6px;
    }

    .markdown-body blockquote {
        border-left: 4px solid #555;
        padding-left: 12px;
        color: #aaa;
        margin-left: 0;
    }
</style>

@code {
    private ElementReference chatContainer;
    private string Prompt = "";

    private List<ChatMessage> Messages = new();

    protected override void OnInitialized()
    {
        Messages = Database.GetMessages();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Messages = Database.GetMessages();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync("scrollChatToBottom", chatContainer);
    }
private async Task Ask()
{
    if (string.IsNullOrWhiteSpace(Prompt))
        return;

    var userPrompt = Prompt;

    Prompt = "";

    var userMessage = new ChatMessage
    {
        Role = "User",
        Content = userPrompt
    };

    Messages.Add(userMessage);

    Database.SaveMessage(userMessage);

    await InvokeAsync(StateHasChanged);

    await ScrollToBottom();

    // Generate embedding
    var embedding =
        await Embeddings.GenerateEmbedding(
            userPrompt);

    // Save memory
    Database.SaveMemory(
        userPrompt,
        embedding);

    // Retrieve relevant memories
    var memories =
        Database.GetRelevantMemories(
            embedding);

    var memoryContext =
        string.Join("\n", memories);

    // Build enhanced prompt
    var enhancedPrompt =
        SystemPrompt.GetSystemPrompt() +
        "\n\nRelevant memories:\n" +
        memoryContext +
        "\n\nUser:\n" +
        userPrompt;

    var assistantMessage = new ChatMessage
    {
        Role = "Assistant",
        Content = ""
    };

    Messages.Add(assistantMessage);

    await InvokeAsync(StateHasChanged);

    await ScrollToBottom();

    // Agent loop
    var currentPrompt = enhancedPrompt;

    for (int i = 0; i < 5; i++)
    {
        var response = "";

        // Stream model response
        await foreach (
            var chunk
            in Ollama.AskStreamAsync(currentPrompt))
        {
            response += chunk;

            assistantMessage.Content = response;

            await InvokeAsync(StateHasChanged);

            await ScrollToBottom();
        }

        // Try tool execution
        var toolResult =
            await ToolExecutor.TryExecuteTool(
                response);

        // No tool → final answer
        if (toolResult == null)
        {
            assistantMessage.Content = response;

            await InvokeAsync(StateHasChanged);

            await ScrollToBottom();

            break;
        }

        // Show tool execution status
        assistantMessage.Content =
            $"Using tool...\n\n{toolResult}";

        await InvokeAsync(StateHasChanged);

        await ScrollToBottom();

        // Continue agent loop
        currentPrompt =
            "Tool result:\n" +
            toolResult +
            "\n\n" +
            "You may:\n" +
            "- use another tool\n" +
            "- or answer naturally";
    }

    Database.SaveMessage(assistantMessage);
}
}
```

